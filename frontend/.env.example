# Frontend environment (Vite) — copy to .env.local for local overrides.
#
# SPLIT DEPLOY (frontend on Vercel, backend on Render/Railway/Fly):
#   Set VITE_API_URL to your backend's public origin. Example:
#   VITE_API_URL=https://agentops.onrender.com
#
# ALL-IN-ONE DEPLOY (single Docker/Render container serves API + UI):
#   Leave VITE_API_URL unset — the frontend calls the same-origin /api.
#
# NOTE: Vite inlines VITE_* vars at BUILD time. After changing this, redeploy
# (not just restart) so the value is baked into the bundle.
VITE_API_URL=
