# AgentOps 2.0 — environment configuration
APP_ENV=development

# SQLite by default; point at PostgreSQL for persistence (e.g. postgres+psycopg://...)
DATABASE_URL=sqlite:///./data/agentops.db

# Simulation
SIMULATION_ENABLED=true
SIMULATION_AUTOSTART=true
SIMULATION_SPEED=1.0
DEVICE_COUNT=12
# Set to a value for reproducible fleets, or "none" for full randomness
RANDOM_SEED=42

# Detection
ANOMALY_THRESHOLD=0.55

# Optional LLM agent mode (deterministic rule engine is the default)
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Server
# PORT is honored by hosting platforms (Render/Railway inject it automatically)
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — first boot seeds this admin account (change password after first login!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=agentops
# Show demo credentials on the login page (auto-disabled when APP_ENV=production)
SHOW_DEMO_CREDS=true

# Feature flags — experimental features ship dark; enable explicitly.
FEATURE_FLAGS=predictive_health=false,chaos_controls=false
